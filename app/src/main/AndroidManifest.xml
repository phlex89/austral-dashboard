<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Austral Dashboard"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImpostazioniActivity"
            android:exported="false" />

        <activity
            android:name=".DiagnosticaActivity"
            android:exported="false" />

        <activity
            android:name=".TemiActivity"
            android:exported="false" />

        <activity
            android:name=".CittaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AppHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ComuniActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BenzinaiActivity"
            android:exported="false" />

        <activity
            android:name=".TutteLeAppActivity"
            android:exported="false" />

        <service
            android:name=".funzioni.AscoltoNotifiche"
            android:exported="true"
            android:label="Austral Dashboard"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".aggiornamenti.AggiornamentoJob"
            android:exported="false"
            android:process=":aggiornamenti"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".aggiornamenti.AvvioReceiver"
            android:exported="true"
            android:process=":aggiornamenti">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".aggiornamenti.EsitoInstallazioneReceiver"
            android:exported="false" />
    </application>
</manifest>
